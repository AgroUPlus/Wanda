<?xml version="1.0" encoding="utf-8"?><!--
  The launcher foreground: Wanda's prism motif.

  Three diamond/wing shapes that form a prism, plus a sharp diamond anchor below —
  the same geometry as the brand SVG. Filled in #00201A (on-teal dark tone) so the
  icon reads on any mask shape and at any density without anti-aliasing artefacts.

  All paths are well inside the safe zone (roughly 66dp of the 108dp canvas on circular
  masks), keeping the motif clear of cropping on all Android launchers.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Central prism spine -->
    <path
        android:pathData="M54,10 L62,38 L54,70 L46,38 Z"
        android:fillColor="#00201A"/>

    <!-- Left wing -->
    <path
        android:pathData="M46,38 L24,48 L38,72 L49,54 Z"
        android:fillColor="#00201A"/>

    <!-- Right wing -->
    <path
        android:pathData="M62,38 L84,48 L70,72 L59,54 Z"
        android:fillColor="#00201A"/>

    <!-- Diamond anchor at the bottom -->
    <path
        android:pathData="M54,76 L60,84 L54,92 L48,84 Z"
        android:fillColor="#00201A"/>
</vector>
