<?xml version="1.0" encoding="utf-8"?><!--
  The themed-icon layer (Android 13+).

  Without one, Wanda is left out of themed icons entirely: the launcher keeps showing
  the full-colour icon while every other app takes the wallpaper's palette.

  Same prism/wing motif as the foreground, scaled and centered within the 66dp safe
  zone so it doesn't get cropped on circular or squircle launcher masks.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="51"
        android:scaleX="0.65"
        android:scaleY="0.65"
        android:translateY="3">

        <!-- Central prism spine -->
        <path
            android:pathData="M54,10 L62,38 L54,70 L46,38 Z"
            android:fillColor="#FFFFFF"/>

        <!-- Left wing -->
        <path
            android:pathData="M46,38 L24,48 L38,72 L49,54 Z"
            android:fillColor="#FFFFFF"/>

        <!-- Right wing -->
        <path
            android:pathData="M62,38 L84,48 L70,72 L59,54 Z"
            android:fillColor="#FFFFFF"/>

        <!-- Diamond anchor at the bottom -->
        <path
            android:pathData="M54,76 L60,84 L54,92 L48,84 Z"
            android:fillColor="#FFFFFF"/>
    </group>
</vector>
