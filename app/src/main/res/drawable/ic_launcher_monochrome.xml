<?xml version="1.0" encoding="utf-8"?><!--
  The themed-icon layer (Android 13+).

  Without one, Wanda is left out of themed icons entirely: the launcher keeps showing
  the full-colour icon while every other app takes the wallpaper's palette.

  Same prism/wing motif as the foreground, no background, no colour of its own —
  the system tints this and supplies the surface behind it. Filled rather than stroked
  because a monochrome glyph has no gradient to give it weight at small sizes.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Central prism spine -->
    <path
        android:pathData="M54,10 L62,38 L54,70 L46,38 Z"
        android:fillColor="#FFFFFF"/>

    <!-- Left wing -->
    <path
        android:pathData="M46,38 L24,48 L38,72 L49,54 Z"
        android:fillColor="#FFFFFF"/>

    <!-- Right wing -->
    <path
        android:pathData="M62,38 L84,48 L70,72 L59,54 Z"
        android:fillColor="#FFFFFF"/>

    <!-- Diamond anchor at the bottom -->
    <path
        android:pathData="M54,76 L60,84 L54,92 L48,84 Z"
        android:fillColor="#FFFFFF"/>
</vector>
