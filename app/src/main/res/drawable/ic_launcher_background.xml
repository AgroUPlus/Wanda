<?xml version="1.0" encoding="utf-8"?><!--
  The launcher background: Wanda's brand teal (#4EE2C0), flat fill.

  The previous violet-to-teal gradient was the Agro ecosystem palette rather than
  Wanda's own identity. The new logo uses a single saturated teal that reads cleanly
  under any launcher mask shape and distinguishes Wanda from Agro at a glance.

  Full-bleed across the 108dp canvas — the launcher supplies the mask shape.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M0,0h108v108h-108z"
        android:fillColor="#4EE2C0"/>
</vector>
