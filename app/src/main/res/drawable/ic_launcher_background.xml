<?xml version="1.0" encoding="utf-8"?><!--
  The launcher background: the app's own violet-to-teal brand pair, on the diagonal.

  It used to be flat black, which is the one thing a Material 3 Expressive icon must not be — the
  style is built on saturated colour and bold shape, and a black square reads as an icon nobody got
  round to drawing. The two stops are `Violet` and `Teal` from `ui/theme/Color.kt`, so the icon and
  the app it opens are recognisably the same product.

  Full-bleed across the 108dp canvas rather than shaped, because the launcher supplies the mask —
  drawing our own rounded corners here would show through as a shape inside a shape.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#7C6BFF"
                android:centerColor="#5A63E8"
                android:endColor="#00A3A3" />
        </aapt:attr>
    </path>
</vector>
