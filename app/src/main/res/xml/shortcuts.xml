<?xml version="1.0" encoding="utf-8"?>
<!--
  Long-press launcher shortcuts. Each is an explicit VIEW of a wanda://shortcut/… link into
  MainActivity, handled by LauncherShortcutHandler — no intent filter claims that host, so only an
  explicit intent reaches it. targetPackage is a string so the .debug builds can override it.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="search"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_search"
        android:shortcutShortLabel="@string/shortcut_search_short"
        android:shortcutLongLabel="@string/shortcut_search_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="@string/shortcut_target_package"
            android:targetClass="com.wander.android.MainActivity"
            android:data="wanda://shortcut/search" />
    </shortcut>
    <shortcut
        android:shortcutId="shuffle_liked"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_shuffle"
        android:shortcutShortLabel="@string/shortcut_shuffle_liked_short"
        android:shortcutLongLabel="@string/shortcut_shuffle_liked_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="@string/shortcut_target_package"
            android:targetClass="com.wander.android.MainActivity"
            android:data="wanda://shortcut/shuffle-liked" />
    </shortcut>
    <shortcut
        android:shortcutId="downloads"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_downloads"
        android:shortcutShortLabel="@string/shortcut_downloads_short"
        android:shortcutLongLabel="@string/shortcut_downloads_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="@string/shortcut_target_package"
            android:targetClass="com.wander.android.MainActivity"
            android:data="wanda://shortcut/downloads" />
    </shortcut>
    <shortcut
        android:shortcutId="recognize"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_recognize"
        android:shortcutShortLabel="@string/shortcut_recognize_short"
        android:shortcutLongLabel="@string/shortcut_recognize_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="@string/shortcut_target_package"
            android:targetClass="com.wander.android.MainActivity"
            android:data="wanda://shortcut/recognize" />
    </shortcut>
</shortcuts>
