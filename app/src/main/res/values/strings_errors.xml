<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown for any failure to reach a server: no connection, timeout, unknown host -->
    <string name="error_network">Couldn\'t connect. Check your connection and try again.</string>
    <!-- Shown when a server refused the account: sign-in expired, wrong credentials, not active -->
    <string name="error_auth">Your sign-in was refused. Sign in again in Settings.</string>
    <!-- Shown when a server answered but couldn't complete the request -->
    <string name="error_server">The server couldn\'t complete that. Try again later.</string>
    <!-- Shown for any other failure -->
    <string name="error_unknown">Something went wrong. Try again.</string>
    <!-- Title over the reason when an album's or playlist's tracks could not be loaded -->
    <string name="collection_tracks_load_failed">Couldn\'t load the tracks</string>
    <!-- Title of an error state when something could not be loaded -->
    <string name="error_load_title">Couldn\'t load this</string>
    <!-- Retry button on an error state -->
    <string name="error_retry">Try again</string>
</resources>
