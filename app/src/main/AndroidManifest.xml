<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      Android 16 took local-network traffic out of INTERNET and put it behind its own runtime
      grant. Without it, connecting to another device on the same Wi-Fi fails as a plain connect
      timeout — indistinguishable from the peer being switched off, which is exactly how it
      presented: `adb shell` could reach the peer's port while the app could not.

      Peer-to-peer sync is the only thing that needs it. Everything else the app talks to is on the
      internet, so a user who never pairs a second device can refuse this and lose nothing.
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!--
        Off-grid peer transport. BLE finds who is in the room; Wi-Fi Direct carries the audio.

        `neverForLocation` on the scan is load-bearing rather than tidy: a BLE scan can be used to
        infer position from nearby beacons, and this app only ever looks for its own service UUID.
        The flag is how that is promised to the system, and it is what keeps the feature from
        needing a location permission at all on Android 12 and later.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Wi-Fi Direct is absent on a real minority of devices; the app is fine without it. -->
    <uses-feature
        android:name="android.hardware.wifi.direct"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!--
      Library sync uploads whole albums, which takes far longer than WorkManager's ~10 minute cap
      for a background worker. The data-sync type is what buys the exemption; note it is budgeted
      at roughly six hours a day on API 34+, so each run is a bounded batch rather than one long
      job. Only used while a sync the user asked for is actually running.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!--
      Recognising music playing in the room, against the user's own library. Requested on demand
      from the listening sheet, never at startup: it is used for the seconds that sheet is open and
      the recording never leaves the device. See `RecognitionRepository`.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
      No usesCleartextTraffic here: with a networkSecurityConfig declared it is ignored from API 24
      on (minSdk is 26), and leaving it set only advertised a blanket plain-HTTP policy the app
      does not actually run under. @xml/network_security_config is the single source of truth.

      allowBackup=false disables cloud backup on every supported version, which is why no
      fullBackupContent companion is declared. dataExtractionRules is still required: on Android
      12+ it is what governs device-to-device transfer, which allowBackup does not cover.
    -->
    <application
        android:name=".WanderApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wanda"
        tools:targetApi="37">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Wanda"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="agro" />
            </intent-filter>
            <!--
              The redirect page's "open in Wanda" button. A user's own share domain is set at
              runtime and an intent filter is not, so the page hands the app its own scheme rather
              than Wanda claiming every https://*/listen URL on the device to catch one domain.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="wanda" android:host="listen" />
                <data android:scheme="wanda" android:host="jam" />
                <data android:scheme="wanda" android:host="inbox" />
                <!-- A friend code, scanned off someone's screen with the system camera. -->
                <data android:scheme="wanda" android:host="friend" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="frwd.top" android:pathPrefix="/jam" />
                <data android:scheme="https" android:host="frwd.top" android:pathPrefix="/listen" />
            </intent-filter>
            <!--
              YouTube and YouTube Music links, so a track someone sends you opens here.
              Deliberately NOT autoVerify: Wanda plays audio and has no video, so it offers
              itself in the chooser rather than quietly taking over every YouTube link on the
              device. Non-track links (channels, playlists) are handed back to the browser —
              see LinkRepository.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="music.youtube.com" />
                <data android:scheme="https" android:host="youtube.com" />
                <data android:scheme="https" android:host="www.youtube.com" />
                <data android:scheme="https" android:host="m.youtube.com" />
                <data android:scheme="https" android:host="youtu.be" />
            </intent-filter>
        </activity>

        <!--
          Not exported: only this app's own MediaController binds to it. Media3 routes
          notification and media-button intents internally.
        -->
        <service
            android:name=".core.playback.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!--
          WorkManager runs long jobs through its own foreground service, and on API 34+ a service
          must declare the type it will use. The FOREGROUND_SERVICE_DATA_SYNC permission alone is
          not enough — without this, promoting the library-sync worker to the foreground throws
          MissingForegroundServiceTypeException the moment it starts.
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- WorkManager is initialised by WanderApplication so Hilt can inject the worker. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
