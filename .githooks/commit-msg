#!/usr/bin/env bash
# .githooks/commit-msg
# Enforces commit conventions, blocks AI co-authorship metadata, and checks CLA compliance.

set -euo pipefail

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")
FIRST_LINE=$(head -n 1 "$COMMIT_MSG_FILE")

# Allow automatic merge, revert, and squash/fixup commits without validation
if [[ "$FIRST_LINE" =~ ^(Merge|Revert|fixup!|squash!) ]]; then
  exit 0
fi

# 1. Block AI co-authorship metadata (per CLA.md Section 8 and AGENTS.md)
FORBIDDEN_PATTERN="(Co-Authored-By:.*(claude|anthropic|chatgpt|openai|copilot|gemini|deepseek|qwen|ai\b)|generated by (claude|chatgpt|copilot|ai\b))"
if echo "$COMMIT_MSG" | grep -Eiq "$FORBIDDEN_PATTERN"; then
  echo -e "\033[0;31m[ERROR] Forbidden AI attribution trailer detected in commit message!\033[0m"
  echo "Per CLA.md Section 8 and AGENTS.md:"
  echo "  - AI models and automated code agents are assistive utilities only."
  echo "  - They are NOT authors or contributors."
  echo "  - Do NOT add 'Co-Authored-By' trailers referencing AI models or tools."
  echo ""
  echo "Offending line:"
  echo "$COMMIT_MSG" | grep -Ei "$FORBIDDEN_PATTERN" | sed 's/^/  /'
  echo ""
  echo "Please edit your commit message to remove this trailer."
  exit 1
fi

# 2. Enforce Conventional Commits format on the subject line
# Pattern: <type>(<optional-scope>): <description>
CONVENTIONAL_PATTERN="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9_./-]+\))?!?: .+$"
if ! [[ "$FIRST_LINE" =~ $CONVENTIONAL_PATTERN ]]; then
  echo -e "\033[0;31m[ERROR] Invalid commit subject line format!\033[0m"
  echo "Expected Conventional Commit format:"
  echo "  <type>(<scope>): <subject>"
  echo ""
  echo "Allowed types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
  echo "Example: feat(playback): enable gapless playback"
  echo ""
  echo "Your message was:"
  echo "  $FIRST_LINE"
  exit 1
fi

# 3. Informational CLA agreement reminder
if ! echo "$COMMIT_MSG" | grep -q "Contribution-License: I agree to the CLA at CLA.md"; then
  echo -e "\033[0;33m[INFO] Remember: Pull requests require CLA agreement (either in commit message or PR description):\033[0m"
  echo "       Contribution-License: I agree to the CLA at CLA.md"
fi

exit 0
